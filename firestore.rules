rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Personal collections: only the owner (matched by the uid field
    // stored inside each document) can read or write their own data.
    match /mood_logs/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    match /journal_entries/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    match /wellness_assessments/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    match /meditation_history/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    match /breathing_sessions/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    match /appointments/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
    }

    // Professionals: anyone signed in can read the directory, but
    // only an admin (isAdmin == true on their own user document) can
    // add, edit, or delete listings.
    match /professionals/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}